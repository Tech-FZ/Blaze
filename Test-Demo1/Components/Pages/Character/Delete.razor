@page "/Character/Delete"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Mappers
@using Test_Demo1.Models
@inject IDbContextFactory<BlazeDbContext> DbFactory
@inject NavigationManager NavigationManager;

<PageTitle>Person löschen - Blaze</PageTitle>

<h1>Person löschen</h1>

<p>Sind Sie sicher, dass Sie folgende Person löschen wollen?</p>

<div>
    @if (characterDto == null)
    {
        <p><em>Bitte warten...</em></p>
    }

    else
    {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@characterDto.Name</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Geburtsdatum</dt>
            <dd class="col-sm-10">@characterDto.BirthDate</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Ist Schüler</dt>
            <dd class="col-sm-10">@characterDto.IsStudent</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Geschlecht</dt>
            <dd class="col-sm-10">@characterDto.SelectedGender!.LongName</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Unternehmen</dt>
            <dd class="col-sm-10">@characterDto.SelectedCompany!.Name</dd>
        </dl>

        <EditForm Model="characterDto" OnValidSubmit="DeleteCharacter" FormName="delete">
            <button type="submit" class="btn btn-danger" disabled="@(characterDto == null)">Löschen</button> |
            <a href="/Character">Zurück zur Personenliste</a>
        </EditForm>
    }
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert" style="margin-top: 10px;">
        <strong>Fehler:</strong> @ErrorMessage
    </div>
}

@code {
    private Character? characterDto;

    private CharacterMapper? characterMapper;

    private string? ErrorMessage {get; set;}

    [SupplyParameterFromQuery]
    private int Id {get; set;}

    protected override void OnParametersSet()
    {
        using var context = DbFactory.CreateDbContext();

        characterDto = context.Characters.Include(c => c.SelectedGender).Include(c => c.SelectedCompany)
            .FirstOrDefault(c => c.Id == Id);

        if (characterDto == null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteCharacter()
    {
        ErrorMessage = null;
        var context = DbFactory.CreateDbContext();

        if (characterDto != null)
        {
            if (context.SocialMedias.Include(sm => sm.SelectedCharacter).Any(sm => sm.SelectedCharacter!.Id == characterDto.Id))
            {
                ErrorMessage = "Diese Person hat noch Einträge zu sozialen Medien. Bitte löschen Sie diese zuerst.";
            }

            else
            {
                context.Characters.Remove(characterDto);
                await context.SaveChangesAsync();
                NavigationManager.NavigateTo("/Character");
            }
        }
    }
}