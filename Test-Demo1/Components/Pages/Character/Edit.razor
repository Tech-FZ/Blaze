@page "/Character/Edit"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Mappers
@using Test_Demo1.Models
@inject IDbContextFactory<BlazeDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit Person - Blaze</PageTitle>

<h1>Edit Person</h1>

<hr />

@if (SelectedCharacter == null)
{
    <p><em>Loading Character...</em></p>
}

else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="SelectedCharacter" OnValidSubmit="UpdateCharacter" FormName="CharEdit"
                      Enhance>
                <DataAnnotationsValidator/>
                <ValidationSummary role="alert"/>
                <input type="hidden" name="SelectedCharacter.Id" value="@SelectedCharacter.Id" />

                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="SelectedCharacter.Name" class="form-control"/>
                    <ValidationMessage For="() => SelectedCharacter.Name" class="text-danger"/>
                </div>

                <div class="mb-3">
                    <label for="birthdate" class="form-label">Birth Date:</label>
                    <InputDate id="birthdate" @bind-Value="SelectedCharacter.BirthDate" class="form-control"/>
                    <ValidationMessage For="() => SelectedCharacter.BirthDate" class="text-danger"/>
                </div>

                <div class="mb-3">
                    <label for="gender" class="form-label">Gender:</label>

                    <QuickGrid Class="table" Items="Genders">
                        <TemplateColumn Context="gender">
                            <input type="radio" checked="@(SelectedCharacter.SelectedGenderId == gender.Id)"
                                name="Gender" @onchange="@(() => SelectedCharacter.SelectedGenderId = gender.Id)" />
                        </TemplateColumn>

                        <PropertyColumn Property="gender => gender.ShortName" Title="Short Name" Sortable="true"/>
                        <PropertyColumn Property="gender => gender.LongName" Title="Long Name" Sortable="true"/>
                    </QuickGrid>
                </div>

                <div class="mb-3">
                    <label for="company" class="form-label">Company:</label>
                    
                    <InputSelect id="company" TValue="int" @bind-Value="SelectedCharacter.SelectedCompanyId"
                        class="form-select">
                        @foreach (var company in Companies)
                        {
                            <option value="@company.Id">@company.Name</option>
                        }
                    </InputSelect>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private BlazeDbContext context = default!;
    private CharacterMapper characterMapper = default!;

    [SupplyParameterFromQuery]
    private int Id {get; set;}

    [SupplyParameterFromForm]
    private CharacterDto? SelectedCharacter {get; set;}

    private IQueryable<Gender> Genders => context.Genders;

    private IQueryable<Company> Companies
    {
        get
        {
            var companyContext = DbFactory.CreateDbContext();
            var companies = companyContext.Companies;
            return companies;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
        characterMapper = new CharacterMapper();

        // todo: filter by id
        SelectedCharacter = context.Characters.AsNoTracking().Select(
            c => characterMapper.FromAToB(c)).ToList()
            .FirstOrDefault(c => c.Id == Id);

        if (SelectedCharacter == null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task UpdateCharacter()
    {
        // TODO: The updates from the UI must be passed on to the actual SelectedCharacter variable.
        context.Attach(characterMapper.FromBToA(SelectedCharacter!)).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }

        catch (DbUpdateConcurrencyException)
        {
            if (!CharacterExists(SelectedCharacter!.Id))
            {
                NavigationManager.NotFound();
            }

            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/Character");
    }

    private bool CharacterExists(int id)
    {
        return context.Characters.Any(c => c.Id == id);
    }
}