@page "/Character/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Models
@inject IDbContextFactory<BlazeDbContext> DbFactory;

<PageTitle>People - Blaze</PageTitle>

<h1>Blaze</h1>
<h2>People</h2>
<hr />
<p><a href="/Character/Create">Create Person Entry</a></p>

<div>
    <QuickGrid Class="table" Items="FilteredCharacters" Pagination="pagination">
        <PropertyColumn Property="character => character.Name" Sortable="true"/>
        <PropertyColumn Property="character => character.BirthDate" Title="Birth Date" Sortable="true"/>
        <PropertyColumn Property="character => character.IsStudent" Title="Is Student"/>
        <PropertyColumn Property="character => character.SelectedGender.ShortName" Title="Gender" />
        <PropertyColumn Property="character => character.SelectedCompany.Name" Title="Company" Sortable="true"/>

        <TemplateColumn Context="character">
            <a href="@($"Character/Details?id={character.Id}")">Details</a> |
            <a href="@($"Character/Edit?id={character.Id}")">Edit</a> |
            <a href="@($"Character/Delete?id={character.Id}")">Delete</a>
        </TemplateColumn>
    </QuickGrid>
</div>

@code {
    private BlazeDbContext context = default!;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    private IQueryable<Character> FilteredCharacters => 
        context.Characters.Include(c => c.SelectedGender).Include(c => c.SelectedCompany);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}