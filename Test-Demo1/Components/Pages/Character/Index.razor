@page "/Character/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Models
@inject IDbContextFactory<BlazeDbContext> DbFactory;

<PageTitle>Personen - Blaze</PageTitle>

<h1>Blaze</h1>
<h2>Personen</h2>
<hr />

<div style="margin-bottom: 10px;">
    <input type="search" @bind="titleFilter" @bind:event="oninput" />
</div>

<p><a href="/Character/Create">Personeneintrag erstellen</a></p>

<div>
    <QuickGrid Class="table" Items="FilteredCharacters" Pagination="pagination">
        <PropertyColumn Property="character => character.Name" Sortable="true"/>
        <PropertyColumn Property="character => character.BirthDate" Title="Geburtsdatum" Sortable="true"/>
        <PropertyColumn Property="character => character.IsStudent" Title="Ist Schüler"/>
        <PropertyColumn Property="character => character.SelectedGender!.ShortName" Title="Geschlecht" />
        <PropertyColumn Property="character => character.SelectedCompany!.Name" Title="Unternehmen" Sortable="true"/>

        <TemplateColumn Context="character">
            <a href="@($"Character/Details?id={character.Id}")">Details</a> |
            <a href="@($"Character/Edit?id={character.Id}")">Bearbeiten</a> |
            <a href="@($"Character/Delete?id={character.Id}")">Löschen</a>
        </TemplateColumn>
    </QuickGrid>
</div>

@code {
    private BlazeDbContext context = default!;
    private string titleFilter = string.Empty;

    private PaginationState pagination = new PaginationState();

    private IQueryable<Character> FilteredCharacters => 
        context.Characters.Include(c => c.SelectedGender).Include(c => c.SelectedCompany)
            .Where(c => c.Name!.Contains(titleFilter) || c.SelectedCompany!.Name!.Contains(titleFilter));

    protected override void OnInitialized()
    {
        base.OnInitialized();
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}