@page "/Company/Create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Models
@inject IDbContextFactory<BlazeDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Company - Blaze</PageTitle>

<h1>Create Company</h1>

<hr />

@if (Company == null)
{
    <p><em>Loading...</em></p>
}

else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Company" OnValidSubmit="AddCompany" FormName="CharEdit">
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="SocialMedia.Id" value="@Company.Id" />

                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Company.Name" class="form-control" />
                    <ValidationMessage For="() => Company.Name" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="link" class="form-label">Net Worth in €:</label>
                    <InputNumber id="link" @bind-Value="Company.NetWorth" class="form-control" />
                    <ValidationMessage For="() => Company.NetWorth" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private BlazeDbContext context = default!;

    private Company Company {get; set;} = new();

    private string? ErrorMessage {get; set;}

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
    }

    private async Task AddCompany()
    {
        ErrorMessage = null;

        context.Entry(Company).State = EntityState.Added;
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/Company");
    }
}