@page "/Company/Delete"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Models
@inject IDbContextFactory<BlazeDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete Company - Blaze</PageTitle>

<h1>Delete Company</h1>

<p>Are you sure you want to delete the following company?</p>

<div>
    @if (company == null)
    {
        <p><em>Loading Company...</em></p>
    }

    else
    {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@company.Name</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Net Worth</dt>
            <dd class="col-sm-10">@company.NetWorth €</dd>
        </dl>

        <EditForm Model="company" OnValidSubmit="DeleteCompany" FormName="delete">
            <button type="submit" class="btn btn-danger" disabled="@(company == null)">Delete</button> |
            <a href="/Company">Back to Company List</a>
        </EditForm>
    }
</div>

@if (!string.IsNullOrEmpty(ErrorMessage))
{
    <div class="alert alert-danger" role="alert" style="margin-top: 10px;">
        <strong>Error:</strong> @ErrorMessage
    </div>
}

@code {
    private Company? company;

    private string? ErrorMessage {get; set;}

    [SupplyParameterFromQuery]
    private int Id {get; set;}

    protected override void OnParametersSet()
    {
        using var context = DbFactory.CreateDbContext();

        base.OnParametersSet();

        // todo: filter by id
        company = context.Companies.AsNoTracking()
            .FirstOrDefault(c => c.Id == Id);

        if (company == null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteCompany()
    {
        ErrorMessage = null;
        var context = DbFactory.CreateDbContext();

        if (company != null)
        {
            if (context.Characters.Any(c => c.SelectedCompanyId == company.Id))
            {
                ErrorMessage = "This company still has employees. Please either delete those or change their companies.";
            }

            else if (context.SocialMedias.Any(sm => sm.SelectedCompanyId == company.Id))
            {
                ErrorMessage = "There are still social media links attached to this company. Please delete those first.";
            }

            else
            {
                context.Companies.Remove(company);
                await context.SaveChangesAsync();
                NavigationManager.NavigateTo("/Company");
            }
        }
    }
}