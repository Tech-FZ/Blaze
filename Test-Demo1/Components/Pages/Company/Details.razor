@page "/Company/Details"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Models
@rendermode InteractiveServer
@inject IDbContextFactory<BlazeDbContext> DbFactory
@inject NavigationManager NavigationManager;

<PageTitle>Company Details - Blaze</PageTitle>

<h1>Company</h1>
<h2>Details</h2>
<hr />

<div>
    @if (company == null)
    {
        <p><em>Loading Company Details...</em></p>
    }

    else
    {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@company!.Name</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Net Worth</dt>
            <dd class="col-sm-10">@company.NetWorth €</dd>
        </dl>

        <QuickGrid Class="table" Items="employees" Pagination="pagination">
            <PropertyColumn Property="character => character.Name" Sortable="true"/>
            <PropertyColumn Property="character => character.BirthDate" Title="Birth Date" Sortable="true"/>
            <PropertyColumn Property="character => character.IsStudent" Title="Is Student"/>
            <PropertyColumn Property="character => character.SelectedGender!.ShortName" Title="Gender" />

            <TemplateColumn Context="character">
                <a href="@($"Character/Details?id={character.Id}")">Details</a> |
                <a href="@($"Character/Edit?id={character.Id}")">Edit</a> |
                <a href="@($"Character/Delete?id={character.Id}")">Delete</a>
            </TemplateColumn>
        </QuickGrid>
        
        <QuickGrid Class="table" Items="socialMedias" Pagination="pagination">
            <PropertyColumn Property="sm => sm.Platform"/>
            <PropertyColumn Property="sm => sm.Link"/>

            <TemplateColumn Context="sm">
                <a href="@($"/SocialMedia/Edit?id={sm.Id}")">Edit</a> |
                <a href="@($"/SocialMedia/Delete?id={sm.Id}")">Delete</a>
            </TemplateColumn>
        </QuickGrid>

        <EditForm Model="company" FormName="delete">
            <a href="/SocialMedia/Create?companyId=@company!.Id">Add Social Media Entry</a> |
            <a href="/Character/Create?companyId=@company!.Id">Add Character Entry</a> |
            <a href="/Company">Back to Company List</a> |
            <a href="/Company/Edit?id=@company!.Id">Edit Company</a> |
            <a href="/Company/Delete?id=@company!.Id">Delete Company</a>
        </EditForm>
    }
</div>

@code {
    private Company? company;
    private IQueryable<SocialMedia>? socialMedias;
    private IQueryable<Character>? employees;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    [SupplyParameterFromQuery]
    private int Id {get; set;}

    protected override void OnParametersSet()
    {
        var context = DbFactory.CreateDbContext();
        var context2 = DbFactory.CreateDbContext();
        var context3 = DbFactory.CreateDbContext();

        company = context.Companies.FirstOrDefault(c => c.Id == Id);
        socialMedias = context2.SocialMedias.Where(sm => sm.SelectedCompanyId == Id);
        employees = context3.Characters.Include(c => c.SelectedGender).Where(c => c.SelectedCompanyId == Id);

        if (company == null)
        {
            NavigationManager.NotFound();
        }
    }
}