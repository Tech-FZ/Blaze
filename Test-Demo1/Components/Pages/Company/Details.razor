@page "/Company/Details"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Models
@rendermode InteractiveServer
@inject IDbContextFactory<BlazeDbContext> DbFactory
@inject NavigationManager NavigationManager;

<PageTitle>Unternehmensdetails - Blaze</PageTitle>

<h1>Unternehmen</h1>
<h2>Details</h2>
<hr />

<div>
    @if (company == null)
    {
        <p><em>Bitte warten...</em></p>
    }

    else
    {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@company!.Name</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Vermögen</dt>
            <dd class="col-sm-10">@company.NetWorth €</dd>
        </dl>

        <QuickGrid Class="table" Items="employees" Pagination="pagination">
            <PropertyColumn Property="character => character.Name" Sortable="true"/>
            <PropertyColumn Property="character => character.BirthDate" Title="Geburtsdatum" Sortable="true"/>
            <PropertyColumn Property="character => character.IsStudent" Title="Ist Schüler"/>
            <PropertyColumn Property="character => character.SelectedGender!.ShortName" Title="Geschlecht" />

            <TemplateColumn Context="character">
                <a href="@($"Character/Details?id={character.Id}")">Details</a> |
                <a href="@($"Character/Edit?id={character.Id}")">Bearbeiten</a> |
                <a href="@($"Character/Delete?id={character.Id}")">Löschen</a>
            </TemplateColumn>
        </QuickGrid>
        
        <QuickGrid Class="table" Items="socialMedias" Pagination="pagination">
            <PropertyColumn Property="sm => sm.Platform"/>
            <PropertyColumn Property="sm => sm.Link"/>

            <TemplateColumn Context="sm">
                <a href="@($"/SocialMedia/Edit?id={sm.Id}")">Bearbeiten</a> |
                <a href="@($"/SocialMedia/Delete?id={sm.Id}")">Löschen</a>
            </TemplateColumn>
        </QuickGrid>

        <EditForm Model="company" FormName="delete">
            <a href="/SocialMedia/Create?companyId=@company!.Id">Eintrag für ein soziales Medium erstellen</a> |
            <a href="/Character/Create?companyId=@company!.Id">Personeneintrag erstellen</a> |
            <a href="/Company">Zurück zur Unternehmensliste</a> |
            <a href="/Company/Edit?id=@company!.Id">Unternehmen bearbeiten</a> |
            <a href="/Company/Delete?id=@company!.Id">Unternehmen löschen</a>
        </EditForm>
    }
</div>

@code {
    private Company? company;
    private IQueryable<SocialMedia>? socialMedias;
    private IQueryable<Character>? employees;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 5 };

    [SupplyParameterFromQuery]
    private int Id {get; set;}

    protected override void OnParametersSet()
    {
        var context = DbFactory.CreateDbContext();
        var context2 = DbFactory.CreateDbContext();
        var context3 = DbFactory.CreateDbContext();

        company = context.Companies.FirstOrDefault(c => c.Id == Id);
        socialMedias = context2.SocialMedias.Where(sm => sm.SelectedCompanyId == Id);
        employees = context3.Characters.Include(c => c.SelectedGender).Where(c => c.SelectedCompanyId == Id);

        if (company == null)
        {
            NavigationManager.NotFound();
        }
    }
}