@page "/Company/Edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Models
@inject IDbContextFactory<BlazeDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Unternehmen bearbeiten - Blaze</PageTitle>

<h1>Unternehmen bearbeiten</h1>

<hr />

@if (Company == null)
{
    <p><em>Bitte warten...</em></p>
}

else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Company" OnValidSubmit="UpdateCompany" FormName="CharEdit">
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="SocialMedia.Id" value="@Company.Id" />

                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Company.Name" class="form-control" />
                    <ValidationMessage For="() => Company.Name" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="link" class="form-label">Vermögen in €:</label>
                    <InputNumber id="link" @bind-Value="Company.NetWorth" class="form-control" />
                    <ValidationMessage For="() => Company.NetWorth" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">Speichern</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private BlazeDbContext context = default!;

    private Company? Company {get; set;}

    private string? ErrorMessage {get; set;}

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        // todo: filter by id
        Company = context.Companies.AsNoTracking()
            .FirstOrDefault(c => c.Id == Id);

        if (Company == null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task UpdateCompany()
    {
        ErrorMessage = null;

        context.Entry(Company!).State = EntityState.Modified;
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/Company");
    }
}