@page "/Gender/Create"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Models
@inject IDbContextFactory<BlazeDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Gender - Blaze</PageTitle>

<h1>Create Gender</h1>

<hr />

@if (Gender == null)
{
    <p><em>Loading...</em></p>
}

else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="Gender" OnValidSubmit="AddGender" FormName="CharEdit">
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="SelectedCharacter.Id" value="@Gender.Id" />

                <div class="mb-3">
                    <label for="shortName" class="form-label">Short Name:</label>
                    <InputText id="shortName" @bind-Value="Gender.ShortName" class="form-control" />
                    <ValidationMessage For="() => Gender.ShortName" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="longName" class="form-label">Long Name:</label>
                    <InputText id="longName" @bind-Value="Gender.LongName" class="form-control" />
                    <ValidationMessage For="() => Gender.LongName" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private BlazeDbContext context = default!;

    private Gender Gender {get; set;} = new();

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
    }

    private async Task AddGender()
    {
        context.Entry(Gender!).State = EntityState.Added;
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/Gender");
    }
}