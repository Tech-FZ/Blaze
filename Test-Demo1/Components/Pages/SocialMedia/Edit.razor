@page "/SocialMedia/Edit"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Test_Demo1.Data
@using Test_Demo1.Models
@inject IDbContextFactory<BlazeDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Eintrag für ein soziales Medium bearbeiten - Blaze</PageTitle>

<h1>Eintrag für ein soziales Medium bearbeiten</h1>

<hr />

@if (SelectedSocialMedia == null)
{
    <p><em>Bitte warten...</em></p>
}

else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm Model="SelectedSocialMedia" OnValidSubmit="UpdateSocialMedia" FormName="CharEdit">
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="SelectedSocialMedia.Id" value="@SelectedSocialMedia.Id" />

                <div class="mb-3">
                    <label for="platform" class="form-label">Plattform:</label>
                    <InputText id="platform" @bind-Value="SelectedSocialMedia.Platform" class="form-control" />
                    <ValidationMessage For="() => SelectedSocialMedia.Platform" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="link" class="form-label">Link:</label>
                    <InputText id="link" @bind-Value="SelectedSocialMedia.Link" class="form-control" />
                    <ValidationMessage For="() => SelectedSocialMedia.Link" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">Speichern</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private BlazeDbContext context = default!;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    private SocialMedia? SelectedSocialMedia {get; set;}

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        // todo: filter by id
        SelectedSocialMedia = context.SocialMedias.AsNoTracking()
            .FirstOrDefault(c => c.Id == Id);

        if (SelectedSocialMedia == null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task UpdateSocialMedia()
    {
        context.Entry<SocialMedia>(SelectedSocialMedia!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }

        catch (DbUpdateConcurrencyException)
        {
            if (!SocialMediaExists(SelectedSocialMedia!.Id))
            {
                NavigationManager.NotFound();
            }

            else
            {
                throw;
            }
        }

        if (SelectedSocialMedia!.SelectedCharacterId != null)
        {
            NavigationManager.NavigateTo($"/Character/Details?id={SelectedSocialMedia.SelectedCharacterId}");
        }

        // Company navigation
        if (SelectedSocialMedia!.SelectedCompanyId != null)
        {
            NavigationManager.NavigateTo($"/Company/Details?id={SelectedSocialMedia.SelectedCompanyId}");
        }
    }

    private bool SocialMediaExists(int id)
    {
        return context.SocialMedias.Any(sm => sm.Id == id);
    }
}